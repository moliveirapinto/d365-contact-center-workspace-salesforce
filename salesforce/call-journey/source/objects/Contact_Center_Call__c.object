    <fields>
        <fullName>Quality_Evaluation_Json__c</fullName>
        <description>Raw D365 Quality Evaluation Agent result (msdyn_evaluationhistory.msdyn_responsejson). Rendered by the Call Journey card.</description>
        <label>Evaluation Details (JSON)</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
