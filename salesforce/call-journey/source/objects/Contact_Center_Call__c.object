        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Quality_Summary__c</fullName>
        <label>Evaluation Summary</label>
        <length>5000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Queue__c</fullName>
        <externalId>false</externalId>
        <label>Queue</label>
        <length>120</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Recording_Url__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(ISBLANK(Conversation_Id__c), ISBLANK($Setup.D365_Contact_Center_Settings__c.Org_Url__c)), &quot;&quot;, IF(RIGHT($Setup.D365_Contact_Center_Settings__c.Org_Url__c, 1) = &quot;/&quot;, LEFT($Setup.D365_Contact_Center_Settings__c.Org_Url__c, LEN($Setup.D365_Contact_Center_Settings__c.Org_Url__c) - 1), $Setup.D365_Contact_Center_Settings__c.Org_Url__c) &amp; &quot;/main.aspx?&quot; &amp; IF(ISBLANK($Setup.D365_Contact_Center_Settings__c.App_Id__c), &quot;&quot;, &quot;appid=&quot; &amp; $Setup.D365_Contact_Center_Settings__c.App_Id__c &amp; &quot;&amp;&quot;) &amp; &quot;navbar=off&amp;pagetype=entityrecord&amp;etn=msdyn_ocliveworkitem&amp;id=&quot; &amp; Conversation_Id__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Recording URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Recording__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Conversation_Id__c), &quot;&quot;, HYPERLINK(Recording_Url__c, &quot;Open call recording &amp; transcript&quot;, &quot;_blank&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Recording &amp; Transcript</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Call Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>In progress</fullName>
                    <default>true</default>
                    <label>In progress</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Talk_Time_Seconds__c</fullName>
        <externalId>false</externalId>
        <label>Talk Time (sec)</label>
        <precision>9</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Duration_Seconds__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(ISBLANK(Call_Ended__c), ISBLANK(Call_Received__c)), null, ROUND((Call_Ended__c - Call_Received__c) * 86400, 0))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Duration (sec)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Virtual_Agent_Seconds__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(ISBLANK(Agent_Connected__c), ISBLANK(Call_Received__c)), null, MAX(0, ROUND((Agent_Connected__c - Call_Received__c) * 86400, 0) - BLANKVALUE(Wait_Time_Seconds__c, 0)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Virtual Agent Time (sec)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Wait_Time_Seconds__c</fullName>
        <externalId>false</externalId>
        <label>Queue Wait (sec)</label>
        <precision>9</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Contact Center Call</label>
    <nameField>
        <label>Call</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Contact Center Calls</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
