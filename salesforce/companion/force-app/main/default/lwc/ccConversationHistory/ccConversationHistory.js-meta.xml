<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Contact Center Conversation History</masterLabel>
    <description>Flow screen component: lists contact center conversations for a customer, read through the Embed SDK.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="contactName" type="String" label="Customer name" role="inputOnly"/>
            <property name="phone" type="String" label="Customer phone" role="inputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
