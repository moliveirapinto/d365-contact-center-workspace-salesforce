      activity:
        text:
          - One moment please. I'm recording your service request before I connect you.
        speak:
          - One moment please. I'm recording your service request before I connect you.

    - kind: SetVariable
      id: setVariable_callerLast10
      variable: Topic.CallerLast10
      value: =Right(Substitute(Substitute(Substitute(Substitute(Substitute(Text(System.Activity.From.Name), "+", ""), " ", ""), "-", ""), "(", ""), ")", ""), 10)

    - kind: InvokeConnectorAction
      id: invokeConnectorAction_findCallerContact
      input:
        binding:
          table: Contact
          $filter: ="Phone_Last10__c eq '" & If(IsBlank(Topic.CallerLast10), "no-match", Topic.CallerLast10) & "' or Mobile_Last10__c eq '" & If(IsBlank(Topic.CallerLast10), "no-match", Topic.CallerLast10) & "'"
